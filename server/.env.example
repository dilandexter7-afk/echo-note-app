# Server Port
PORT=5000

# PostgreSQL Connection String (Supabase / Neon / Render)
# Format: postgres://[user]:[password]@[host]:[port]/[database]
# Note: SSL is handled automatically in db.js with rejectUnauthorized: false
DATABASE_URL=postgres://postgres:[YOUR-SUPABASE-PASSWORD]@db.exvnvxqcoirxinemkrnl.supabase.co:5432/postgres

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional Frontend URL for Production CORS (e.g. https://your-app.vercel.app)
CLIENT_URL=http://localhost:5173
